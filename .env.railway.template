# Railway Environment Variables Template
# Copy these to your Railway project's Variables section

# === Database Configuration ===
# Railway will provide this automatically if you add a PostgreSQL service
DATABASE_URL=postgresql://username:password@hostname:port/database

# === Redis Configuration ===
# Railway will provide this automatically if you add a Redis service
REDIS_URL=redis://hostname:port

# === Security ===
SECRET_KEY=your-super-secret-key-here-generate-a-strong-one
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# === OpenAI Configuration ===
# Required for AI assistants functionality
OPENAI_API_KEY=your-openai-api-key-here

# === Environment Settings ===
ENVIRONMENT=production
DEBUG=false

# === CORS Configuration ===
# Update with your frontend URLs - separate multiple URLs with commas
ALLOWED_ORIGINS=https://razor303jc.github.io,https://razorflow-ai.vercel.app

# === Optional: Email Configuration ===
# If you plan to add email notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# === Optional: JWT Configuration ===
# For user authentication if implemented
JWT_SECRET_KEY=another-super-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# === Optional: Rate Limiting ===
# API rate limiting configuration
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_BURST=200

# Notes:
# 1. Generate strong SECRET_KEY: python -c "import secrets; print(secrets.token_urlsafe(32))"
# 2. Never commit this file to git - it's for reference only
# 3. Set these variables in Railway Dashboard → Your Service → Variables tab
# 4. Railway automatically provides PORT variable - don't set it manually
