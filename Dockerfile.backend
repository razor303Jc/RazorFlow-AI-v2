# Enhanced Dockerfile for RazorFlow AI Backend with Debugging
FROM python:3.11-slim

# Set environment variables for better debugging
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONFAULTHANDLER=1
ENV PYTHONHASHSEED=random
ENV PIP_NO_CACHE_DIR=1
ENV PIP_DISABLE_PIP_VERSION_CHECK=1
ENV PORT=8000

# Install system dependencies and debugging tools
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        postgresql-client \
        build-essential \
        libpq-dev \
        curl \
        wget \
        vim \
        htop \
        strace \
        tcpdump \
        netcat-traditional \
        iputils-ping \
        dnsutils \
        telnet \
        procps \
    && rm -rf /var/lib/apt/lists/*

# Set work directory
WORKDIR /app

# Create directories for logs and debugging
RUN mkdir -p /app/logs /app/debug /tmp/razorflow

# Copy requirements and install Python dependencies
COPY backend/requirements.txt /app/requirements.txt

# Install Python packages with debugging support
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir \
        psutil \
        memory-profiler \
        line-profiler \
        py-spy \
        pytest \
        pytest-asyncio \
        pytest-cov

# Copy application code
COPY backend/ /app/src/

# Copy debugging and monitoring scripts
COPY scripts/debug/ /app/debug/
COPY scripts/health-check.sh /app/health-check.sh
COPY scripts/startup.sh /app/startup.sh

# Make scripts executable
RUN chmod +x /app/debug/*.sh /app/health-check.sh /app/startup.sh

# Create symlink for main.py in root for easier access
RUN ln -s /app/src/main.py /app/main.py

# Create non-root user for security but with debugging capabilities
RUN adduser --disabled-password --gecos '' appuser \
    && usermod -aG sudo appuser \
    && chown -R appuser:appuser /app \
    && chown -R appuser:appuser /tmp/razorflow

# Switch to app user
USER appuser

# Enhanced health check with detailed logging
HEALTHCHECK --interval=30s --timeout=30s --start-period=5s --retries=3 \
    CMD /app/health-check.sh

# Expose port
EXPOSE $PORT

# Enhanced startup script with debugging
CMD ["/app/startup.sh"]
